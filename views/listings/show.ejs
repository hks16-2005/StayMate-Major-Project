<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h2>Listing Details</h2>
        </div>
        <div class="col-6 offset-3">
            <div class="card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing image">
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%= listing.title %>
                        </b><br>
                        <%= listing.description %> <br>
                            &#8377 <%= listing.price.toLocaleString("en-IN") %> <br>
                                <%= listing.location %> <br>
                                    <%= listing.country %>
                    </p>
                </div>
            </div>
        </div>
        </div>
        <div class="row">
            <form method="GET" action="/listings/<%= listing._id %>/edit" class="col-6 col-md-2 offset-3 mb-3 mb-md-0">
                <button class="btn btn-dark edit-btn w-50 w-md-75">Edit</button>
            </form>

            <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE"
                onsubmit="return confirm('Are you sure you want to delete this listing?')" class="col-6 offset-3 col-md-2 offset-md-0">
                <button class="btn btn-dark w-50 w-md-75">Delete</button>
            </form>
        </div>



    