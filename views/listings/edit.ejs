<%- layout("/layouts/boilerplate.ejs") %>


    <body>
        <div class="row mt-3">
            <div class="col-8 offset-2">
                <h2>Edit Your Listing </h2>
                <form method="POST" action="/listings/<%=listing.id%>?_method=PUT">

                    <div class="mb-4">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" type="text" value="<%= listing.title %>" name="listing[title]"
                            class="form-control">
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control"
                            name="listing[description]"><%= listing.description %></textarea>

                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="image">Image</label>
                        <input id="image" class="form-control" value="<%= listing.image %>" type="text"
                            placeholder="Enter image url" name="listing[image]">

                    </div>

                    <div class="row">
                        <div class="mb-4 col-md-4">
                            <label class="form-label" for="price">Price</label>
                            <input id="price" class="form-control" value="<%= listing.price %>" type="number"
                                name="listing[price]">

                        </div>
                        <div class="mb-4 col-md-8">
                            <label class="form-label" for="country">Country</label>
                            <input id="country" class="form-control" value="<%= listing.country %>" type="text"
                                name="listing[country]">

                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="location">Location</label>
                        <input id="location" class="form-control" value="<%= listing.location %>" type="text"
                            name="listing[location]">

                    </div>
                    <div class="text-center mb-3">
                        <button class="btn btn-dark  edit-btn">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </body>

    </html>