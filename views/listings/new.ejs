<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayMate</title>
</head>
<body>
    <h2>Create New Listing</h2>
    <form method="POST" action="/listings">
        <input type="text" placeholder="Enter the title" name="listing[title]"><br><br>
        <textarea cols="40" rows="5" placeholder="Enter the description" name="listing[description]"></textarea><br><br>
        <input type="text" placeholder="Enter the image url" name="listing[image]"><br><br>
        <input type="number" placeholder="Enter the price" name="listing[price]"><br><br>
        <input type="text" placeholder="Enter the location" name="listing[location]"><br><br>
        <input type="text" placeholder="Enter the country" name="listing[country]"><br><br>
        <button>Add</button>
    </form>
</body>
</html>